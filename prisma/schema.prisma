generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String?
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  sessions  Session[]
  urls      Url[]
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Url {
  id           Int       @id @default(autoincrement())
  originalUrl  String
  shortCode    String    @unique
  clicks       Int       @default(0)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  userId       Int?
  anonymousId  String?
  active       Boolean   @default(true)

  clickRecords Click[]
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shortCode])
  @@index([anonymousId])
}

model Click {
  id        Int      @id @default(autoincrement())
  urlId     Int
  createdAt DateTime @default(now())
  referrer  String?
  userAgent String?
  country   String?
  url       Url      @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@index([urlId])
  @@index([createdAt])
  @@index([country])
}
